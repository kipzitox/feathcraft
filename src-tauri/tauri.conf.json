{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fheatcraft",
  "version": "1.0.0",
  "identifier": "com.fheatcraft.app",
  "build": {
    "frontendDist": "../dist-tauri",
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "fheatcraft",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
